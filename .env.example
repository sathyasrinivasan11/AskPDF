# Required for Gemini chat and embeddings.
GOOGLE_API_KEY=your_google_ai_studio_key

# Free-tier Gemini defaults; change only if your account has access to another model.
ASKPDF_CHAT_MODEL=gemini-2.0-flash
ASKPDF_EMBEDDING_MODEL=models/text-embedding-004

# Local persistent state (relative to the repository by default).
ASKPDF_DATA_DIR=data
ASKPDF_TOP_K=6
ASKPDF_CHUNK_SIZE=1200
ASKPDF_CHUNK_OVERLAP=180
